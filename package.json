{
  "name": "deadclick",
  "version": "0.1.0",
  "description": "Automated UI interaction testing and dead click detection for websites",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "deadclick": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "testing",
    "playwright",
    "ui-testing",
    "dead-click",
    "automation",
    "qa",
    "browser-testing"
  ],
  "author": "Prateek",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@typescript/typescript6": "^6.0.2",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
